generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

// Exemplo de um modelo de usuário para o MongoDB

model despesas {
    id            String    @id @default(auto()) @map("_id") @db.ObjectId
    conta         String?
    valor         Float?
    descricao     String?
    fornecedor    String?
    tipo          String?
    data          DateTime?
    comprovante   String?
    boleto        String?
    pago          Boolean?  @default(false)
    loja          String?
    /// Mês da folha que originou esta despesa: "YYYY-MM" para salários e
    /// "13-YYYY-MM" para o 13º. Marca o lançamento mantido em sincronia com o
    /// total pago na folha — ver `app/models/folha.server.ts`. Ausente nas manuais.
    origem_folha_mes String?
}

type FolhaSalarios {
    sal_id String
    /// "salario", "decimo_1" ou "decimo_2" — ver `app/lib/folha.ts`.
    tipo   String
    valor  Float
    data   DateTime @db.Date
    pago   Boolean
}

/// Funcionários da folha (coleção própria do Brassaço, não é do ERP).
model folha {
    id       String          @id @default(auto()) @map("_id") @db.ObjectId
    nome     String
    conta    String
    salarios FolhaSalarios[]

    @@map("folha_brassaco")
}

// Coleção compartilhada com o ERP: o nome do fornecedor mora em `razaoSocial`.
/// Coleção do ERP (projeto `pdv`, model `Fornecedor`) — o formato é dele.
/// Lá `codigo` é único e obrigatório, assim como cidade, bairro, ativo e as
/// datas: um documento sem eles quebra a leitura no ERP e, sem `codigo`, ocupa
/// o único "null" do índice único. Ficam opcionais aqui só para ler cadastros
/// antigos; quem grava é `createFornecedor`, que preenche todos.
model fornecedores {
    id           String    @id @default(auto()) @map("_id") @db.ObjectId
    codigo       String?   @unique
    nome         String?   @map("razaoSocial")
    nomeFantasia String?
    cidade       String?
    bairro       String?
    documento    String?
    tipoPessoa   String?
    ativo        Boolean?
    criadoEm     DateTime?
    atualizadoEm DateTime?
}

model receitas {
    id            String    @id @default(auto()) @map("_id") @db.ObjectId
    conta         String?
    valor         Float?
    descricao     String?
    loja          String?
    data          DateTime? @default(now())
}

model compras {
    id         String    @id @default(auto()) @map("_id") @db.ObjectId
    valor      Float?
    fornecedor String?
    nf         Json?
    data       DateTime? @default(now())
}

model estoque {
    id    String    @id @default(auto()) @map("_id") @db.ObjectId
    valor Float?
    data  DateTime? @default(now())
    local String?
}

type Exercicio {
    nome       String?
    Repeticoes String?
    obs        String?
    video      String?
    carga      String?
}

// Coleção alimentada pelo ERP: `codigo` é numérico e a unidade mora em `unid`.
model produtos_preco {
    id          String  @id @default(auto()) @map("_id") @db.ObjectId
    codigo      Int
    descricao   String
    unidade     String? @map("unid")
    preco       Float
    grupo       Float?
    complemento String?
    quantidade  String?
}

