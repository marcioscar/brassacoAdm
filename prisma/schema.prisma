generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

// Exemplo de um modelo de usuário para o MongoDB

model despesas {
    id            String    @id @default(auto()) @map("_id") @db.ObjectId
    conta         String?
    valor         Float?
    descricao     String?
    fornecedor    String?
    tipo          String?
    data          DateTime?
    comprovante   String?
    boleto        String?
    pago          Boolean?  @default(false)
    loja          String?
}

// Coleção compartilhada com o ERP: o nome do fornecedor mora em `razaoSocial`.
model fornecedores {
    id   String  @id @default(auto()) @map("_id") @db.ObjectId
    nome String? @map("razaoSocial")
}

model receitas {
    id            String    @id @default(auto()) @map("_id") @db.ObjectId
    conta         String?
    valor         Float?
    descricao     String?
    loja          String?
    data          DateTime? @default(now())
}

model compras {
    id         String    @id @default(auto()) @map("_id") @db.ObjectId
    valor      Float?
    fornecedor String?
    nf         Json?
    data       DateTime? @default(now())
}

model estoque {
    id    String    @id @default(auto()) @map("_id") @db.ObjectId
    valor Float?
    data  DateTime? @default(now())
    local String?
}

type Exercicio {
    nome       String?
    Repeticoes String?
    obs        String?
    video      String?
    carga      String?
}

// Coleção alimentada pelo ERP: `codigo` é numérico e a unidade mora em `unid`.
model produtos_preco {
    id          String  @id @default(auto()) @map("_id") @db.ObjectId
    codigo      Int
    descricao   String
    unidade     String? @map("unid")
    preco       Float
    grupo       Float?
    complemento String?
    quantidade  String?
}

